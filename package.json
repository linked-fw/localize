{
  "name": "@_linked/localize",
  "version": "0.2.0",
  "description": "Develop an npm dependency from a git checkout: resolve the package's repository from the registry, clone it, install inside the checkout, and symlink it into node_modules -- without touching package.json or package-lock.json.",
  "keywords": [
    "npm",
    "link",
    "symlink",
    "monorepo",
    "local",
    "development",
    "clone",
    "workspace"
  ],
  "license": "MIT",
  "author": "Semantu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linked-fw/localize.git"
  },
  "homepage": "https://github.com/linked-fw/localize#readme",
  "bugs": "https://github.com/linked-fw/localize/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=18.17"
  },
  "bin": {
    "linked-localize": "bin/linked-localize.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:fast": "node --test --test-skip-pattern='^slow:' test/*.test.js"
  }
}
